{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Greg The Skeptic (Byzantine Auditor)",
          "version": "1.0.0",
          "informationUri": "https://hermes-agent.nousresearch.com/docs",
          "rules": [
            {
              "id": "ROLE-001",
              "name": "RoleBoundaryCompliance",
              "shortDescription": {
                "text": "Verifies that all domain tasks were executed strictly by assigned specialist eric without orchestrator inline bypass."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FILE-001",
              "name": "OutputFilesVerification",
              "shortDescription": {
                "text": "Verifies all required artifact deliverables exist on disk and SHA-256 hashes cryptographically match output/SHA256SUMS.txt."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-IDEM-001",
              "name": "IdempotentDeduplicationVerification",
              "shortDescription": {
                "text": "Verifies exactly 375 unique events processed out of 500 under 25 percent duplicate injection with 0 double executions and 100 percent duplicate suppression returning HTTP 200 already_processed."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-HMAC-001",
              "name": "HmacTamperResistanceVerification",
              "shortDescription": {
                "text": "Verifies HMAC SHA-256 signature tampering rejected with HTTP 401 across 100 fuzz iterations in sub-0.2ms constant-time evaluation."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-REPLAY-001",
              "name": "ReplayAttackWindowVerification",
              "shortDescription": {
                "text": "Verifies replay attack window expiration older than 300s rejected with HTTP 400 Bad Request."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-ROLLBACK-001",
              "name": "TransactionalRollbackVerification",
              "shortDescription": {
                "text": "Verifies transactional rollback under mid-flight failure with zero ghost events or dangling credits in PostgreSQL."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SECURITY-001",
              "name": "SecurityAndOwaspVerification",
              "shortDescription": {
                "text": "Audits constant-time comparison, parameterized SQL statements, exception containment, and secret handling."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "STYLE-EMDASH-001",
              "name": "PunctuationStandard",
              "shortDescription": {
                "text": "Verifies strict zero em dashes across all code comments, configuration files, reports, and manifests."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ROLE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Role execution complies with strict boundaries: D7-R1 (Sandbox Build) and D7-R2 (Stress Probe) executed strictly by assigned specialist eric; reviewer gate executed by reviewer with zero orchestrator inline leakage."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/webhook_security_and_idempotency_report.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "FILE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "All required deliverables exist on disk and SHA-256 hashes cryptographically match output/SHA256SUMS.txt with 100 percent integrity."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/SHA256SUMS.txt"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-IDEM-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Idempotency verified: exactly 375 unique events processed out of 500 under 25 percent duplicate injection with 0 double executions. All 125 duplicate deliveries handled with HTTP 200 and status already_processed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/webhook_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-HMAC-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "HMAC SHA-256 tamper resistance verified: 100 of 100 1-character flipped body payloads rejected with HTTP 401 Unauthorized. Server-side constant-time cryptographic validation latency p50 is 0.082 ms (strictly within 0.2ms threshold)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/com/albidox/webhook/security/HmacSecurityFilter.java"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-REPLAY-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Replay attack window expiration verified: payload aged 360s rejected with HTTP 400 Bad Request in 4.31 ms without invoking business layer. Future timestamps shifted by 360s also rejected with HTTP 400."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/stress_probe_results.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-ROLLBACK-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Transactional rollback verified: mid-flight failure resulted in HTTP 500 with 0 ghost events in processed_events and 0 records in payment_ledger. Subsequent client retry succeeded cleanly with exactly 1 ledger record."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/com/albidox/webhook/service/WebhookEventService.java"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SECURITY-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Security and OWASP audit passed: constant-time MessageDigest.isEqual protects against timing attacks; parameterized JdbcTemplate statements prevent SQL injection; CachedBodyHttpServletRequest safely buffers raw bytes; zero credentials leaked."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/com/albidox/webhook/security/HmacSecurityFilter.java"
                }
              }
            }
          ]
        },
        {
          "ruleId": "STYLE-EMDASH-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Strict zero em dashes check passed: 0 em dashes detected across all project files, code comments, configuration manifests, and markdown reports."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/webhook_security_and_idempotency_report.md"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "verdict": "MERGE_APPROVED",
        "auditOutcome": "ZERO_DEFECTS",
        "reviewerProfile": "reviewer"
      }
    }
  ]
}