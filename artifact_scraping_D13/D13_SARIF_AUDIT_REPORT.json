{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Greg The Skeptic (Byzantine Auditor)",
          "version": "1.0.0",
          "informationUri": "https://hermes-agent.nousresearch.com/docs",
          "rules": [
            {
              "id": "ROLE-001",
              "name": "RoleBoundaryCompliance",
              "shortDescription": {
                "text": "Verifies that all domain implementation tasks were executed strictly by assigned specialist eric without orchestrator inline bypass."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FILE-001",
              "name": "DeliverablesAndChecksumIntegrity",
              "shortDescription": {
                "text": "Verifies all required artifact deliverables exist on disk and SHA-256 hashes cryptographically match output/SHA256SUMS.txt."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-SCALE-001",
              "name": "DatasetScaleAndThroughputGate",
              "shortDescription": {
                "text": "Verifies exactly 25,000 URLs extracted from nested gzipped archives in under 10.0 seconds."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-MEMORY-001",
              "name": "HostProcessMemoryCeiling",
              "shortDescription": {
                "text": "Verifies host process memory usage never exceeds 45.0 MB RAM during 25,000 URL streaming extraction."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-EXPORT-001",
              "name": "ParquetAndCsvDatasetIntegrity",
              "shortDescription": {
                "text": "Verifies both CSV and Apache Parquet datasets contain exactly 25,000 valid rows with 100% loc parity and typed schemas."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-RESILIENCE-GZIP-001",
              "name": "CorruptedGzipArchiveIsolation",
              "shortDescription": {
                "text": "Verifies corrupted magic header in sub-sitemap part 5 is safely isolated without pipeline crashes, salvaging remaining archives."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-RESILIENCE-XML-001",
              "name": "MalformedXmlRecovery",
              "shortDescription": {
                "text": "Verifies unclosed XML tags and unescaped entities are auto-recovered via lxml iterparse recovery mode."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-RESILIENCE-429-001",
              "name": "CdnRateLimitExponentialBackoff",
              "shortDescription": {
                "text": "Verifies HTTP 429 rate limiting triggers exponential backoff and extracts all records with zero drops."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "STYLE-EMDASH-001",
              "name": "PunctuationStandardZeroEmDashes",
              "shortDescription": {
                "text": "Verifies strict zero em dashes across all code, comments, reports, manifests, and documentation."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ROLE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Role execution complies with strict boundaries: D13-R1 (Sandbox Build) and D13-R2 (Real-World Stress Probe) executed strictly by assigned specialist eric; reviewer audit gate executed by reviewer with zero orchestrator inline bypass."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_resilience_probe_report.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "FILE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "All 5 required output deliverables exist on disk and SHA-256 checksums match output/SHA256SUMS.txt cryptographically with zero discrepancies."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/SHA256SUMS.txt"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-SCALE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Exactly 25,000 URLs extracted across 10 nested gzipped archives in 0.8190 seconds (30,525.25 URLs/second), comfortably within the 10.0-second SLA limit."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-MEMORY-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Peak host process memory reached 38.56 MB RAM, remaining strictly beneath the 45.0 MB RAM ceiling via streaming iterparse DOM pruning."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-EXPORT-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Parquet and CSV export integrity verified. Exactly 25,000 rows present in both sitemap_urls.parquet and sitemap_urls.csv with 25,000 unique URLs and typed schema."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_urls.parquet"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-RESILIENCE-GZIP-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Corrupted gzip magic header in part 5 was cleanly isolated without scraper termination, logging corrupted archive URL and salvaging exactly 22,500 valid URLs from the remaining 9 archives."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_stress_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-RESILIENCE-XML-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Unclosed XML tags and unescaped entities recovered successfully via lxml.etree.XMLParser(recover=True), salvaging all readable nodes across all 10 archives with 25,000 URLs extracted."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_stress_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-RESILIENCE-429-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: HTTP 429 rate limiting with Retry-After directives handled via exponential backoff, successfully extracting 100% of records (25,000 URLs) with zero dropped items."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_stress_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "STYLE-EMDASH-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Strict zero em dashes check passed: 0 em dashes detected across all code, comments, reports, manifests, and documentation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/sitemap_resilience_probe_report.md"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "verdict": "MERGE_APPROVED",
        "auditOutcome": "ZERO_DEFECTS",
        "reviewerProfile": "reviewer"
      }
    }
  ]
}
