{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Greg The Skeptic (Byzantine Auditor)",
          "version": "1.0.0",
          "informationUri": "https://hermes-agent.nousresearch.com/docs",
          "rules": [
            {
              "id": "ROLE-001",
              "name": "RoleBoundaryCompliance",
              "shortDescription": {
                "text": "Verifies that all domain implementation tasks were executed strictly by assigned specialist eric without orchestrator inline bypass."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "FILE-001",
              "name": "DeliverablesAndChecksumIntegrity",
              "shortDescription": {
                "text": "Verifies all required artifact deliverables exist on disk and SHA-256 hashes cryptographically match output/SHA256SUMS.txt."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-INGEST-001",
              "name": "DatasetScaleAndThroughputGate",
              "shortDescription": {
                "text": "Verifies exactly 500,000 rows committed to PostgreSQL 18 on port 5433 in under 5.0 seconds exceeding 100,000 rows/second."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-MEMORY-001",
              "name": "HostProcessMemoryCeiling",
              "shortDescription": {
                "text": "Verifies host process memory usage never exceeds 35.0 MB RAM during 500,000 row streaming ingestion."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-QUARANTINE-001",
              "name": "DirtyRowQuarantineIsolation",
              "shortDescription": {
                "text": "Verifies staging-table atomic validation isolates dirty rows into quarantined_rows.csv while committing 499,999 valid rows without batch abort."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-UNLOGGED-001",
              "name": "UnloggedTableAcceleration",
              "shortDescription": {
                "text": "Verifies unlogged staging table acceleration and 100% WAL disk write reduction during copy phase."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "METRIC-DISCONNECT-001",
              "name": "MidFlightDisconnectRollback",
              "shortDescription": {
                "text": "Verifies mid-flight socket termination results in atomic transaction rollback with 0 surviving orphan rows."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "STYLE-EMDASH-001",
              "name": "PunctuationStandardZeroEmDashes",
              "shortDescription": {
                "text": "Verifies strict zero em dashes across all code, comments, reports, manifests, and documentation."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ROLE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Role execution complies with strict boundaries: D12-R1 (Sandbox Build) and D12-R2 (Real-World Stress Probe) executed strictly by assigned specialist eric; reviewer audit gate executed by reviewer with zero orchestrator inline bypass."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/postgres_copy_ingestion_report.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "FILE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "All 21 deliverables exist on disk and SHA-256 checksums match output/SHA256SUMS.txt cryptographically with zero discrepancies."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/SHA256SUMS.txt"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-INGEST-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Exactly 500,000 rows committed to PostgreSQL 18 table on port 5433 in 3.9519 seconds (126,522.54 rows/second, 16.23 MB/second), surpassing the >100,000 rows/second SLA."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/ingestion_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-MEMORY-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Host process memory footprint peaked at 24.38 MB RAM during Round 1 streaming COPY and 21.21 MB RAM during Round 2 quarantine probe, strictly beneath the 35.0 MB RAM ceiling."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/ingestion_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-QUARANTINE-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Dirty row quarantine isolated malformed row 250,000 into quarantined_rows.csv while committing exactly 499,999 valid rows without batch abort under staging-table atomic validation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/quarantine_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-UNLOGGED-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Unlogged staging table ingestion achieved 131,350.09 rows/second (1.07x speedup over logged baseline) and reduced WAL disk write volume from 54.72 MB to 0.0000 MB (100.00% WAL reduction during COPY)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/unlogged_bench_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "METRIC-DISCONNECT-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Hero metric confirmed: Mid-flight socket severing via pg_terminate_backend at row 300,000 resulted in complete atomic rollback, confirming 0 surviving orphan rows and 0 partial writes."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/disconnect_probe_metrics.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "STYLE-EMDASH-001",
          "level": "none",
          "kind": "pass",
          "message": {
            "text": "Strict zero em dashes check passed: 0 em dashes detected across all code, comments, reports, manifests, and documentation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/postgres_copy_ingestion_report.md"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "verdict": "MERGE_APPROVED",
        "auditOutcome": "ZERO_DEFECTS",
        "reviewerProfile": "reviewer"
      }
    }
  ]
}
