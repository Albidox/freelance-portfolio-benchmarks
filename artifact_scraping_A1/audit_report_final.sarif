{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Hermes Byzantine Auditor",
          "rules": [
            {
              "id": "ROLE_COMPLIANCE",
              "name": "RoleBoundaryCompliance",
              "shortDescription": { "text": "Specialist remained in designated jurisdiction." }
            },
            {
              "id": "ZERO_DEFECT_SEC",
              "name": "ZeroDefectSecurity",
              "shortDescription": { "text": "No critical vulnerabilities or race conditions." }
            },
            {
              "id": "DATA_PROVENANCE",
              "name": "LiveNetworkProvenance",
              "shortDescription": { "text": "Artifact was sourced from live external network." }
            },
            {
              "id": "ZERO_HALLUCINATION",
              "name": "AntiHallucinationGate",
              "shortDescription": { "text": "Zero fabricated successes against hard targets." }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ROLE_COMPLIANCE",
          "level": "none",
          "message": { "text": "Role boundary compliance verified. Orchestrator did not execute inline domain work. Implementation executed cleanly by target specialist." },
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "scraper.py"}}}]
        },
        {
          "ruleId": "ZERO_DEFECT_SEC",
          "level": "none",
          "message": { "text": "Zero unhandled exceptions and no detected injection vectors. Cryptographic checksums valid." },
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "scraper.py"}, "region": {"startLine": 1, "endLine": 182}}}]
        },
        {
          "ruleId": "DATA_PROVENANCE",
          "level": "none",
          "message": { "text": "1,000 product records explicitly fetched from 50 pages via books.toscrape.com, matching logged SHA-256 artifacts. Real network requests verified in probe_real_sites.py." },
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "probe_real_sites.py"}}}]
        },
        {
          "ruleId": "ZERO_HALLUCINATION",
          "level": "none",
          "message": { "text": "Accurately recorded 0/5 Scrapling successes and correct HTTP 403 / Empty Response metrics for WAF-protected targets. Zero hallucinated successes." },
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "output/real_world_probe_report.md"}, "region": {"startLine": 1, "endLine": 30}}}]
        }
      ]
    }
  ]
}