{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0-rtm.5.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Hermes Byzantine Auditor (Greg)",
          "version": "1.0.0",
          "informationUri": "https://hermes-agent.nousresearch.com/docs"
        }
      },
      "results": [
        {
          "ruleId": "INV-001",
          "level": "note",
          "message": {
            "text": "Role Compliance Verified: Worker adhered strictly to target profile and specification boundaries. No orchestration scope creep detected."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "jsonb_architecture_decision_matrix.md"
                }
              }
            }
          ]
        },
        {
          "ruleId": "INV-002",
          "level": "note",
          "message": {
            "text": "Security & Concurrency Verified: Zero-downtime migration protocols properly followed (CREATE INDEX CONCURRENTLY, lock_timeout configured)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "V4__optimize_jsonb_queries.sql"
                }
              }
            }
          ]
        },
        {
          "ruleId": "INV-003",
          "level": "note",
          "message": {
            "text": "Zero Plausible Fabrication Verified: Benchmark metrics (0.358 ms, 0.560 ms, sizes 37 MB, 74 MB) exactly match the empirical output files."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "README.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}