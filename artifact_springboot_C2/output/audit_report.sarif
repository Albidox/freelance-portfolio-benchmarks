{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Greg (The Skeptic) Byzantine Auditor",
          "rules": [
            {
              "id": "ROLE_COMPLIANCE",
              "shortDescription": {
                "text": "Role Boundary Compliance Audit"
              }
            },
            {
              "id": "SECURITY_VETO",
              "shortDescription": {
                "text": "Zero-Defect Security Audit"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ROLE_COMPLIANCE",
          "level": "note",
          "message": {
            "text": "Role boundaries observed. Task executed strictly by the assigned specialist without inline orchestration shortcuts. Zero plausible fabrication; all metrics and errors backed by true compilation and surefire execution outputs."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "output/compile_error.txt"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SECURITY_VETO",
          "level": "note",
          "message": {
            "text": "Spring Security 6 modernization architecture approved. The WebSecurityConfigurerAdapter was correctly removed, and the lambda DSL implemented without exposing endpoints. Enterprise migration documentation properly mandates stateless CSRF logic and strong PasswordEncoders (BCrypt/Argon2)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/com/example/security/SecurityConfig.java"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}