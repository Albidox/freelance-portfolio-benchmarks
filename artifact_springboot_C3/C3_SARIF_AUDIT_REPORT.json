          "rules": [
            {
              "id": "SEC-001",
              "name": "SecurityAndCorrectnessVeto",
              "shortDescription": {
                "text": "AST Correctness and Security Invariants."
              }
            },
            {
              "id": "ROLE-001",
              "name": "RoleBoundaryComplianceVeto",
